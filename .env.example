# Smart Data Quality Monitoring System - environment overrides
# Copy to `.env` and adjust. Values here override config/config.yaml.
# Environment variables use the DQMS_ prefix and __ as the nesting delimiter.

# Directory where input datasets are read from.
DQMS_PATHS__INPUT_DIR=./data/input

# Directory where reports and exports are written.
DQMS_PATHS__OUTPUT_DIR=./output

# Logging verbosity: TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR, CRITICAL
DQMS_LOGGING__LEVEL=INFO

# Hard limit on the size of files the loader will accept (megabytes).
DQMS_SECURITY__MAX_FILE_SIZE_MB=512
